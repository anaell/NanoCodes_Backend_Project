generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mysql"
}

model cache {
  key        String @id @db.VarChar(255)
  value      String @db.MediumText
  expiration Int
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String  @db.LongText
  options        String? @db.LongText
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  queue        String @db.VarChar(255)
  payload      String @db.LongText
  attempts     Int    @db.UnsignedTinyInt
  reserved_at  Int?   @db.UnsignedInt
  available_at Int    @db.UnsignedInt
  created_at   Int    @db.UnsignedInt

  @@index([queue])
}

model password_reset_tokens {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       String?
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String  @db.LongText
  last_activity Int

  @@index([last_activity])
  @@index([user_id])
}

model Artisan {
  id                             String                          @id
  user_id                        String                          @unique
  location                       String
  experience                     Int
  rating                         Float
  about_artisan                  String?
  main_skill                     String?
  min_price_per_hour             Decimal?                        @db.Decimal(20, 2)
  response_time                  Int?
  verified                       Boolean                         @default(false)
  total_money_made               Decimal?                        @db.Decimal(20, 2)
  total_money_withdrawn          Decimal?                        @db.Decimal(20, 2)
  created_at                     DateTime                        @default(now())
  updated_at                     DateTime
  User                           User                            @relation(fields: [user_id], references: [id])
  Artisan_Skill                  Artisan_Skill[]
  Artisan_Verification_Documents Artisan_Verification_Documents?
  Booking                        Booking[]
  Booking_Review                 Booking_Review[]
  Favourite                      Favourite[]
  Payment                        Payment[]
  Service                        Service[]
}

model Artisan_Review_Reply {
  id                     String         @id
  reply                  String
  review_id              String         @unique
  created_at             DateTime       @default(now())
  report_customer_review Boolean        @default(false)
  Booking_Review         Booking_Review @relation(fields: [review_id], references: [id])
}

model Artisan_Skill {
  artisan_id String
  skill_id   String
  Artisan    Artisan @relation(fields: [artisan_id], references: [id])
  Skill      Skill   @relation(fields: [skill_id], references: [id])

  @@id([artisan_id, skill_id])
  @@index([skill_id], map: "Artisan_Skill_skill_id_fkey")
}

model Artisan_Verification_Documents {
  id                            String                                @id
  status                        Artisan_Verification_Documents_status @default(pending)
  nin_doc_url                   String?
  profession_credential_doc_url String?
  artisan_id                    String                                @unique
  created_at                    DateTime                              @default(now())
  updated_at                    DateTime
  Artisan                       Artisan                               @relation(fields: [artisan_id], references: [id])
}

model Bank_Detail {
  id           String @id
  account_no   String
  bank_name    String
  account_name String
  user_id      String @unique
  User         User   @relation(fields: [user_id], references: [id])
}

model Booking {
  id                  String            @id
  customer_id         String
  artisan_id          String
  status              Booking_status    @default(pending)
  created_at          DateTime          @default(now())
  updated_at          DateTime
  booking_address     String?
  booking_end_date    DateTime?
  booking_price       Decimal           @db.Decimal(20, 2)
  booking_start_date  DateTime
  problem_description String
  work_to_be_done     String
  is_cancelled        Boolean           @default(false)
  Artisan             Artisan           @relation(fields: [artisan_id], references: [id])
  User                User              @relation(fields: [customer_id], references: [id])
  Booking_Picture     Booking_Picture[]
  Booking_Review      Booking_Review?
  Payment             Payment?

  @@index([artisan_id], map: "Booking_artisan_id_fkey")
  @@index([customer_id], map: "Booking_customer_id_fkey")
}

model Booking_Picture {
  id         String  @id
  booking_id String
  url        String
  Booking    Booking @relation(fields: [booking_id], references: [id])

  @@index([booking_id], map: "Booking_Picture_booking_id_fkey")
}

model Booking_Review {
  id                   String                @id
  comment              String?
  rating               Int
  status               Booking_Review_status @default(published)
  customer_id          String
  booking_id           String                @unique
  created_at           DateTime              @default(now())
  updated_at           DateTime
  artisanId            String?
  Artisan_Review_Reply Artisan_Review_Reply?
  Artisan              Artisan?              @relation(fields: [artisanId], references: [id])
  Booking              Booking               @relation(fields: [booking_id], references: [id])
  User                 User                  @relation(fields: [customer_id], references: [id])

  @@index([artisanId], map: "Booking_Review_artisanId_fkey")
  @@index([customer_id], map: "Booking_Review_customer_id_fkey")
}

model Favourite {
  id         String  @id @default(cuid())
  user_id    String
  artisan_id String
  Artisan    Artisan @relation(fields: [artisan_id], references: [id])
  User       User    @relation(fields: [user_id], references: [id])

  @@unique([user_id, artisan_id])
  @@index([artisan_id], map: "Favourite_artisan_id_fkey")
}

model Newsletter {
  id         String   @id
  email      String   @unique
  created_at DateTime @default(now())
}

model Notification {
  id         String   @id
  user_id    String
  message    String
  read       Boolean  @default(false)
  created_at DateTime @default(now())
  User       User     @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "Notification_user_id_fkey")
}

model Payment {
  id                   String         @id
  amount               Decimal        @db.Decimal(20, 2)
  status               Payment_status @default(processing)
  payment_method       String
  artisan_id           String
  customer_id          String
  booking_id           String         @unique
  payment_completed_at DateTime
  created_at           DateTime       @default(now())
  updated_at           DateTime
  commission           Int
  Artisan              Artisan        @relation(fields: [artisan_id], references: [id])
  Booking              Booking        @relation(fields: [booking_id], references: [id])
  User                 User           @relation(fields: [customer_id], references: [id])

  @@index([artisan_id], map: "Payment_artisan_id_fkey")
  @@index([customer_id], map: "Payment_customer_id_fkey")
}

model Service {
  id          String  @id
  name        String
  description String
  price       Decimal @db.Decimal(20, 2)
  artisan_id  String
  Artisan     Artisan @relation(fields: [artisan_id], references: [id])

  @@index([artisan_id], map: "Service_artisan_id_fkey")
}

model Skill {
  id            String          @id
  name          String          @unique
  Artisan_Skill Artisan_Skill[]
}

model System_Info {
  id                String   @id
  platform_name     String
  platform_logo_url String
  support_email     String
  maintenance_mode  Boolean  @default(false)
  updated_at        DateTime
  is_singleton      Boolean  @unique @default(true)
}

model User {
  id                             String           @id
  role                           User_role        @default(user)
  email                          String           @unique
  password                       String
  phone_no                       String?          @unique
  whatsapp_no                    String?          @unique
  f_name                         String
  l_name                         String
  profile_pic_url                String?
  nin                            String?          @unique
  created_at                     DateTime         @default(now())
  updated_at                     DateTime
  preferred_booking_address      String?
  is_deleted                     Boolean          @default(false)
  is_suspended                   Boolean          @default(false)
  total_amount_spent_on_bookings Decimal?         @db.Decimal(20, 2)
  email_verified_at              DateTime?        @db.Timestamp(0)
  remember_token                 String?          @db.VarChar(100)
  Artisan                        Artisan?
  Bank_Detail                    Bank_Detail?
  Booking                        Booking[]
  Booking_Review                 Booking_Review[]
  Favourite                      Favourite[]
  Notification                   Notification[]
  Payment                        Payment[]
}

model Admin_User {
  admin_id String @id
  name     String
  password String
  email    String @unique
}

model personal_access_tokens {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tokenable_type String    @db.VarChar(255)
  tokenable_id   String
  name           String    @db.VarChar(255)
  token          String    @unique(map: "personal_access_tokens_token_unique") @db.VarChar(64)
  abilities      String?   @db.Text
  last_used_at   DateTime? @db.Timestamp(0)
  expires_at     DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([tokenable_type, tokenable_id])
}

enum Artisan_Verification_Documents_status {
  pending
  accepted
  rejected
  more_info_required
}

enum User_role {
  user
  artisan
  admin
}

enum Payment_status {
  processing
  successful
}

enum Booking_status {
  pending
  accepted
  rejected
  in_progress
  cancelled
  completed
}

enum Booking_Review_status {
  published
  deleted
  reported
}
