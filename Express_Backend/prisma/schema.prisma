// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// An enum for the roles that a User can have. It can be a user, artisan, or admin.
enum Role {
  user
  artisan
  admin
}

// An enum for the status of a booking. It can be pending, accepted, rejected, or completed.
enum BookingStatus {
  pending
  accepted
  rejected
  in_progress
  completed
}

// This is for the Users that will be using the application. It is a one-to-many relationship between Users and Reviews, Users and Notifications, Users and Bookings, Users and Favourites, and a one-to-one relationship between Users and Bank_Details.
model User {
  id                        String         @id @default(uuid(7))
  // Role related stuff
  role                      Role           @default(user)
  // Authentication Information
  email                     String         @unique()
  password                  String
  // Contact Information
  phone_no                  String?        @unique()
  whatsapp_no               String?        @unique()
  // Personal Information
  f_name                    String
  l_name                    String
  profile_pic_url           String?
  nin                       String?        @unique()
  // Bank details relation
  account_details           Bank_Details?
  reviews                   Review[]
  artisan                   Artisan?
  notifications             Notification[]
  bookings                  Booking[]
  preferred_booking_address String?
  favourite_artisans        Favourite[]
  // Timestamps
  created_at                DateTime       @default(now())
  updated_at                DateTime       @updatedAt
}

// This is for the Bank Details that a User can have. It is a one-to-one relationship between Users and Bank_Details.
model Bank_Details {
  id           String @id @default(uuid(7))
  account_no   String
  bank_name    String
  account_name String
  user         User   @relation(fields: [user_id], references: [id])
  user_id      String @unique()
}

// This is for Reviews that a User can leave for an Artisan. It is a many-to-many relationship between Users and Artisans, with additional fields for the review details.
model Review {
  id      String  @id @default(uuid(7))
  comment String?
  rating  Int

  // Customer relation
  customer    User   @relation(fields: [customer_id], references: [id])
  customer_id String

  // Artisan relation
  artisan    Artisan  @relation(fields: [artisan_id], references: [id])
  artisan_id String
  booking    Booking?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// This is for the Artisans that a User can hire. Users that are artisans get this included for them. It is a one-to-one relationship between Users and Artisans.
model Artisan {
  id                 String          @id @default(uuid(7))
  user               User            @relation(fields: [user_id], references: [id])
  user_id            String          @unique
  // Artisan related stuff
  main_skill         String?
  skills             Artisan_Skill[]
  location           String
  experience         Int
  rating             Float
  reviews            Review[]
  bookings           Booking[]
  verified           Boolean         @default(false)
  about_artisan      String?
  response_time      Int?
  services           Service[]
  favourited_by      Favourite[]
  min_price_per_hour Float?
}

// This is for the Skills that an Artisan can have. It is a many-to-many relationship between Artisans and Skills.
model Skill {
  id       String          @id @default(uuid(7))
  name     String          @unique()
  artisans Artisan_Skill[]
}

// This is for the notifications that a User receives. It is a one-to-many relationship between Users and Notifications.
model Notification {
  id         String   @id @default(uuid(7))
  user       User     @relation(fields: [user_id], references: [id])
  user_id    String
  message    String
  read       Boolean  @default(false)
  created_at DateTime @default(now())
}

// This model is used for the Bookings that a User makes to an Artisan. It is a many-to-many relationship between Users and Artisans, with additional fields for the booking details.
model Booking {
  id                       String            @id @default(uuid(7))
  customer                 User              @relation(fields: [customer_id], references: [id])
  customer_id              String
  artisan                  Artisan           @relation(fields: [artisan_id], references: [id])
  artisan_id               String
  status                   BookingStatus     @default(pending)
  problem_description      String
  work_to_be_done          String
  booking_price            Float
  booking_related_pictures Booking_Picture[]
  booking_start_date       DateTime
  booking_end_date         DateTime?
  booking_address          String?
  review                   Review?           @relation(fields: [review_id], references: [id])
  review_id                String?           @unique()
  created_at               DateTime          @default(now())
  updated_at               DateTime          @updatedAt
}

// This is a joint table for the many-to-many relationship between Artisans and Skills. An Artisan can have many skills, and a Skill can belong to many Artisans.
model Artisan_Skill {
  // id         String  @id @default(uuid(7))
  artisan    Artisan @relation(fields: [artisan_id], references: [id])
  artisan_id String
  skill      Skill   @relation(fields: [skill_id], references: [id])
  skill_id   String

  @@id(name: "ArtisanSkill", fields: [artisan_id, skill_id])
}

// For services that an Artisan can provide. This is a one-to-many relationship between Artisans and Services.
model Service {
  id          String @id @default(uuid(7))
  name        String
  description String
  price       Float

  artisan    Artisan @relation(fields: [artisan_id], references: [id])
  artisan_id String
}

// For email and newsletter subscriptions.
model Newsletter {
  id         String   @id @default(uuid(7))
  email      String   @unique()
  created_at DateTime @default(now())
}

// This model is for Artisans that a User has favourited. It is a many-to-many relationship between Users and Artisans.
model Favourite {
  id         String  @id @default(uuid(7))
  user       User    @relation(fields: [user_id], references: [id])
  user_id    String
  artisan    Artisan @relation(fields: [artisan_id], references: [id])
  artisan_id String

  @@unique([user_id, artisan_id])
}

// This model is for the Booking Pictures that may be unloaded by the customer during booking.
model Booking_Picture {
  id         String  @id @default(uuid(7))
  booking    Booking @relation(fields: [booking_id], references: [id])
  booking_id String
  url        String
}
