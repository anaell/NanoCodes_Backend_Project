// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// An enum for the roles that a User can have. It can be a user, artisan, or admin.
enum Role {
  user
  artisan
  admin
}

// An enum for the status of a booking. It can be pending, accepted, rejected, or completed.
enum BookingStatus {
  pending
  accepted
  rejected
  in_progress
  cancelled
  completed
}

enum PaymentStatus {
  processing
  successful
}

enum ArtisanVerificationDocumentsStatus {
  pending
  accepted
  rejected
  more_info_required
}

enum BookingReviewStatus {
  published
  deleted
  reported
}

// This is for the Users that will be using the application. It is a one-to-many relationship between Users and Reviews, Users and Notifications, Users and Bookings, Users and Favourites, and a one-to-one relationship between Users and Bank_Details.
model User {
  id String @id @default(uuid(7))

  // Role related stuff
  role Role @default(user)

  // Authentication Information
  email    String @unique()
  password String

  // MISSING LARAVEL AUTH FIELDS:
  email_verified_at DateTime? @db.Timestamp(0) // Tracks if the user verified their email
  remember_token    String?   @db.VarChar(100) // Used for standard web "Remember Me" sessions

  // Contact Information
  phone_no    String? @unique()
  whatsapp_no String? @unique()

  // Personal Information
  f_name          String
  l_name          String
  profile_pic_url String?
  nin             String? @unique()

  // Bank details relation
  account_details           Bank_Detail?
  reviews                   Booking_Review[]
  artisan                   Artisan?
  notifications             Notification[]
  bookings                  Booking[]
  preferred_booking_address String?
  favourite_artisans        Favourite[]

  // Timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  payments                       Payment[]
  total_amount_spent_on_bookings Float?
  is_suspended                   Boolean   @default(false)
  is_deleted                     Boolean   @default(false)
}

// This is for the Bank Details that a User can have. It is a one-to-one relationship between Users and Bank_Details.
model Bank_Detail {
  id           String @id @default(uuid(7))
  account_no   String
  bank_name    String
  account_name String
  user         User   @relation(fields: [user_id], references: [id])
  user_id      String @unique()
}

// This is for Reviews that a User can leave for an Artisan. It is a many-to-many relationship between Users and Artisans, with additional fields for the review details.
model Booking_Review {
  id      String                @id @default(uuid(7))
  comment String?
  rating  Int
  reply   Artisan_Review_Reply?
  status  BookingReviewStatus   @default(published)

  // Customer relation
  customer    User   @relation(fields: [customer_id], references: [id])
  customer_id String

  // Artisan relation
  // artisan    Artisan @relation(fields: [artisan_id], references: [id])
  // artisan_id String

  // Booking relation
  booking    Booking @relation(fields: [booking_id], references: [id])
  booking_id String  @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  artisan    Artisan? @relation(fields: [artisanId], references: [id])
  artisanId  String?
}

// This is for the Artisans that a User can hire. Users that are artisans get this included for them. It is a one-to-one relationship between Users and Artisans.
model Artisan {
  id                           String                          @id @default(uuid(7))
  user                         User                            @relation(fields: [user_id], references: [id])
  user_id                      String                          @unique
  // Artisan related stuff
  main_skill                   String?
  skills                       Artisan_Skill[]
  location                     String
  experience                   Int
  rating                       Float
  reviews                      Booking_Review[]
  bookings                     Booking[]
  verified                     Boolean                         @default(false)
  about_artisan                String?
  response_time                Int?
  services                     Service[]
  favourited_by                Favourite[]
  min_price_per_hour           Float?
  payments                     Payment[]
  total_money_made             Float?
  total_money_withdrawn        Float?
  artisanVerificationDocuments Artisan_Verification_Documents?
}

// This is for the Skills that an Artisan can have. It is a many-to-many relationship between Artisans and Skills.
model Skill {
  id       String          @id @default(uuid(7))
  name     String          @unique()
  artisans Artisan_Skill[]
}

// This is for the notifications that a User receives. It is a one-to-many relationship between Users and Notifications.
model Notification {
  id         String   @id @default(uuid(7))
  user       User     @relation(fields: [user_id], references: [id])
  user_id    String
  message    String
  read       Boolean  @default(false)
  created_at DateTime @default(now())
}

// This model is used for the Bookings that a User makes to an Artisan. It is a many-to-many relationship between Users and Artisans, with additional fields for the booking details.
model Booking {
  id                       String            @id @default(uuid(7))
  customer                 User              @relation(fields: [customer_id], references: [id])
  customer_id              String
  artisan                  Artisan           @relation(fields: [artisan_id], references: [id])
  artisan_id               String
  status                   BookingStatus     @default(pending)
  problem_description      String
  work_to_be_done          String
  booking_price            Float
  booking_related_pictures Booking_Picture[]
  booking_start_date       DateTime
  booking_end_date         DateTime?
  booking_address          String?
  review                   Booking_Review?
  payment_details          Payment?
  created_at               DateTime          @default(now())
  updated_at               DateTime          @updatedAt
}

// This is a joint table for the many-to-many relationship between Artisans and Skills. An Artisan can have many skills, and a Skill can belong to many Artisans.
model Artisan_Skill {
  // id         String  @id @default(uuid(7))
  artisan    Artisan @relation(fields: [artisan_id], references: [id])
  artisan_id String
  skill      Skill   @relation(fields: [skill_id], references: [id])
  skill_id   String

  @@id(name: "ArtisanSkill", fields: [artisan_id, skill_id])
}

// For services that an Artisan can provide. This is a one-to-many relationship between Artisans and Services.
model Service {
  id          String @id @default(uuid(7))
  name        String
  description String
  price       Float

  artisan    Artisan @relation(fields: [artisan_id], references: [id])
  artisan_id String
}

// For email and newsletter subscriptions.
model Newsletter {
  id         String   @id @default(uuid(7))
  email      String   @unique()
  created_at DateTime @default(now())
}

// This model is for Artisans that a User has favourited. It is a many-to-many relationship between Users and Artisans.
model Favourite {
  id         String  @id @default(uuid(7))
  user       User    @relation(fields: [user_id], references: [id])
  user_id    String
  artisan    Artisan @relation(fields: [artisan_id], references: [id])
  artisan_id String

  @@unique([user_id, artisan_id])
}

// This model is for the Booking Pictures that may be unloaded by the customer during booking.
model Booking_Picture {
  id         String  @id @default(uuid(7))
  booking    Booking @relation(fields: [booking_id], references: [id])
  booking_id String
  url        String
}

model Artisan_Review_Reply {
  id        String         @id @default(uuid(7))
  reply     String
  review    Booking_Review @relation(fields: [review_id], references: [id])
  review_id String         @unique

  created_at DateTime @default(now())
}

model Payment {
  id             String        @id @default(uuid())
  amount         Float
  status         PaymentStatus @default(processing)
  payment_method String

  artisan    Artisan @relation(fields: [artisan_id], references: [id])
  artisan_id String

  customer    User   @relation(fields: [customer_id], references: [id])
  customer_id String

  booking    Booking @relation(fields: [booking_id], references: [id])
  booking_id String  @unique

  payment_completed_at DateTime
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
}

model Artisan_Verification_Documents {
  id     String                             @id @default(uuid())
  status ArtisanVerificationDocumentsStatus @default(pending)

  nin_doc_url                   String?
  profession_credential_doc_url String?

  artisan    Artisan @relation(fields: [artisan_id], references: [id])
  artisan_id String  @unique

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model System_Info {
  id                String   @id @default(uuid(7))
  platform_name     String
  platform_logo_url String
  support_email     String
  maintenance_mode  Boolean  @default(false)
  updated_at        DateTime @updatedAt
}

// THE BELOW IS FOR LARAVEL AUTHENTICATION. THE AUTH IS BEING HANDLED BY LARAVEL SO THAT IS WHY THESE WERE ADDED.
// 1. LARAVEL SESSION TABLE (Required by SESSION_DRIVER=database)
model Session {
  id            String  @id @db.VarChar(255)
  user_id       String? // Matches your User id String/UUID type
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String  @db.LongText
  last_activity Int

  @@index([user_id])
  @@index([last_activity])
  @@map("sessions")
}

// 2. LARAVEL CACHE TABLES (Required by CACHE_STORE=database)
model Cache {
  key        String @id @db.VarChar(255)
  value      String @db.MediumText
  expiration Int

  @@map("cache")
}

model CacheLock {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int

  @@map("cache_locks")
}

// 3. LARAVEL QUEUE/JOBS TABLES (Required by QUEUE_CONNECTION=database)
model Job {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  queue        String @db.VarChar(255)
  payload      String @db.LongText
  attempts     Int    @db.UnsignedTinyInt
  reserved_at  Int?   @db.UnsignedInt
  available_at Int    @db.UnsignedInt
  created_at   Int    @db.UnsignedInt

  @@index([queue])
  @@map("jobs")
}

model JobBatch {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String  @db.LongText
  options        String? @db.LongText
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?

  @@map("job_batches")
}

model FailedJob {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)

  @@map("failed_jobs")
}

// 4. LARAVEL PASSWORD RESET TOKENS (Built-in Auth Core)
model PasswordResetToken {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)

  @@map("password_reset_tokens")
}

// 5. LARAVEL SANCTUM TOKENS (Required by laravel/sanctum dependency)
model PersonalAccessToken {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tokenable_type String    @db.VarChar(255)
  tokenable_id   String // Matches your User id String/UUID type
  name           String    @db.VarChar(255)
  token          String    @unique(map: "personal_access_tokens_token_unique") @db.VarChar(64)
  abilities      String?   @db.Text
  last_used_at   DateTime? @db.Timestamp(0)
  expires_at     DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([tokenable_type, tokenable_id])
  @@map("personal_access_tokens")
}
